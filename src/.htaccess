# TODO: update value of URI_ROOT.

DirectoryIndex index.php
Options -Indexes

ServerSignature off

<IfModule rewrite_module>
	# Redirect and apply changes to
	# request data:
	RewriteEngine On

	# Do not accept malformed requests
	RewriteCond %{THE_REQUEST} !^(GET|POST)\ [a-zA-Z0-9\.\+_/\-\?\=\&]+\ HTTP/ [NC]
	RewriteRule ^ - [F,NS,L]

	<IfDefine !HASF_IO_DEBUG>
		# Remove: www.
		RewriteCond %{HTTP_HOST} ^www\.(.*)$ [NC]
		RewriteRule ^ https://%1%{REQUEST_URI} [QSA,L,R=301]

		# Use HTTPS instead of HTTP.
		RewriteCond %{HTTPS} off
		RewriteCond %{HTTP:X-Forwarded-Proto} !https [NC]
		RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [QSA,L,R=301]
	</IfDefine>

	# Redirect to public directory, if
	# it is not included in the URI.
	RewriteCond %{REQUEST_URI} !^/${URI_ROOT}/public/
	RewriteRule (.*) /${URI_ROOT}/public/$1 [QSA,L]
</IfModule>

